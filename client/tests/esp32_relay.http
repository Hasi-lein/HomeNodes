@host = venus.local:1881
@username = {{$prompt 'Node-RED HTTP Basic Auth username'}}
@password = {{$prompt 'Node-RED HTTP Basic Auth password'}}

### Read the latest Victron battery voltage from Venus OS Node-RED
# @name batteryVoltage
GET https://{{host}}/homenodes/v1/battery-voltage
Authorization: Basic {{username}}:{{password}}
Accept: application/json
