@host = esp32-relay-01.local
@username = {{$prompt 'HomeNodes API username'}}
@password = {{$prompt 'ESP32 API password'}}

### Read client health, sensor and actuator status, and local time
# @name status
GET https://{{host}}/api/v1/status
Authorization: Basic {{username}} {{password}}
Accept: application/json

### Enable automatic heater control (still subject to all safety conditions)
# @name enableHeater
POST https://{{host}}/api/v1/relay
Authorization: Basic {{username}} {{password}}
Content-Type: application/json
Accept: application/json

{
  "state": "on"
}

### Disable heater unconditionally
# @name disableHeater
POST https://{{host}}/api/v1/relay
Authorization: Basic {{username}} {{password}}
Content-Type: application/json
Accept: application/json

{
  "state": "off"
}

### Set the persistent heater target temperature (5-35 C)
# @name setTargetTemperature
POST https://{{host}}/api/v1/settings
Authorization: Basic {{username}} {{password}}
Content-Type: application/json
Accept: application/json

{
  "targetTemperatureC": 21
}

### Persistently enable automatic heater control
# @name enableHeaterSetting
POST https://{{host}}/api/v1/settings
Authorization: Basic {{username}} {{password}}
Content-Type: application/json
Accept: application/json

{
  "heaterEnabled": true
}

### Persistently disable automatic heater control
# @name disableHeaterSetting
POST https://{{host}}/api/v1/settings
Authorization: Basic {{username}} {{password}}
Content-Type: application/json
Accept: application/json

{
  "heaterEnabled": false
}

### Enable persistent API transaction logging
# @name enableApiLogging
POST https://{{host}}/api/v1/settings
Authorization: Basic {{username}} {{password}}
Content-Type: application/json
Accept: application/json

{
  "apiLoggingEnabled": true
}

### Disable persistent API transaction logging
# @name disableApiLogging
POST https://{{host}}/api/v1/settings
Authorization: Basic {{username}} {{password}}
Content-Type: application/json
Accept: application/json

{
  "apiLoggingEnabled": false
}
